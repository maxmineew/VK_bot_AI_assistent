# Скопируйте этот файл в .env и заполните своими значениями.
# .env никогда не коммитить и никому не передавать (см. .gitignore).

# Токен сообщества ВК: Управление → Работа с API → Ключи доступа,
# права: «Сообщения» (+ в сообществе включены Long Poll API и «Возможности ботов»)
VK_TOKEN=vk1.a.СЮДА_ТОКЕН_СООБЩЕСТВА

# Токен Telegram-бота от @BotFather
TG_TOKEN=1234567890:AAF-СЮДА_ТОКЕН_БОТА

# Ваш числовой chat_id (подскажет @userinfobot)
TG_CHAT=123456789

# Числовой id вашей личной страницы ВК (vk.com/id123456) — для /reset и дубля сводки.
# Можно оставить пустым — бот будет работать без них.
ADMIN_VK_ID=
